<?xml version="1.0" encoding="UTF-8"?>
<!--
    launchd agent.
      cp scripts/com.clapoff.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.clapoff.plist

    Edit the clapoff path below if `which clapoff` says something else.
    macOS will ask for microphone permission the first time. Say yes, obviously.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clapoff</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/clapoff</string>
        <string>--no-banner</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/clapoff.log</string>
</dict>
</plist>
